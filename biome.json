{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    },
    "enabled": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 140
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "markdown": {
    "formatter": {
      "enabled": true,
      "lineWidth": 120,
      "proseWrap": "always"
    }
  },
  "yaml": {
    "formatter": {
      "enabled": false
    }
  }
}
