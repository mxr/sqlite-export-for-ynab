// ~~ Generated by projen in mxr/base. Modifications will be overwritten on the next sync. To modify properly, edit .github/base.yml and retrigger the propagate workflow in mxr/base.
{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "commitMessageAction": "weekly",
  "commitMessagePrefix": "[renovate]",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/main\\.yml$/"],
      "matchStrings": ["\\sos: (?<depName>windows)-(?<currentValue>\\S+)"],
      "datasourceTemplate": "github-runners",
      "versioningTemplate": "docker"
    }
  ],
  "extends": ["config:recommended", ":disableDependencyDashboard"],
  "groupSingleUpdates": true,
  "minimumReleaseAge": "7 days",
  "packageRules": [
    {
      "commitMessageExtra": " ",
      "groupName": "update",
      "matchPackageNames": ["*"]
    },
    {
      "matchDatasources": ["github-runners"],
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    }
  ],
  "prBodyTemplate": "{{{table}}}",
  "schedule": ["* 21-22 * * 1"],
  "separateMajorMinor": false,
  "separateMultipleMajor": false
}
